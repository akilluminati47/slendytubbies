# Raw Sketchfab downloads - re-fetch with tools/fetch_sketchfab.py.
# Anything the game loads at runtime belongs in assets/game/ instead.
node_modules/
assets/models/

# Local editor/debug config
.claude/

# The rigged models the game ships: the in-browser retargeter (src/entities/
# tubbyRig.js) loads skin/ and donor/ at runtime, so they are committed and
# deployed. Only the parts the game never loads stay ignored:
# - chaser/  the static no-skeleton TinkyWinkyNPC rip (face already shipped as
#            assets/game/face_tinkywinky.png) - never loaded.
# - tubbies.glb / tubbies.json  artifacts of the old abandoned Blender bake.
assets/game/rig/chaser/
# donor/dipsy: the Garry's Mod biped the players used to ride. Everybody now
# uses donor/tinkywinky, whose clips were made for this shape. 9MB unshipped.
assets/game/rig/donor/dipsy/
assets/game/tubbies.glb
assets/game/tubbies.json

# Worker local state
worker/node_modules/
.wrangler/
dist/
